DISCORD_TOKEN=your_discord_bot_token
CODEX_USER_AGENT="Kodded/1.0 (+https://github.com/Soupgorn/kodded)"
SEND_STARTUP_TEST=false
# Optional; defaults to /app/data/kodded.sqlite
DATABASE_PATH=/app/data/kodded.sqlite
# Optional one-time legacy import. Keep existing production values on upgrade.
# DISCORD_GUILD_ID=your_existing_server_id
# DISCORD_CHANNEL_ID=your_existing_channel_id

# Optional global forecast defaults; existing guilds remain opted out until enabled.
# FORECAST_MIN_24H=40
# FORECAST_INCREASE_24H=10
# FORECAST_MIN_48H=60
# FORECAST_INCREASE_48H=15
# FORECAST_COOLDOWN_HOURS=6
